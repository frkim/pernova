# Local demo. No Azure resource or credential is required.
# The default npm run dev uses these defaults without an environment file.
# To load this file explicitly for the API, copy it to .env then run:
# uv run --env-file .env --project backend uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
PERNOVA_MODE=demo
PERNOVA_DATA_DIR=data
PERNOVA_STEP_DELAY_SECONDS=0.8
PERNOVA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PERNOVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Connected mode requires reviewed tenant configuration; never expose demo mode.
# Set explicit HTTPS hosts/origins instead of the loopback defaults above.
# Define and grant backend roles: Reader, Operator, Approver, SecurityAdmin, Admin, Agent.
# No values below are credentials; never put tokens, keys or client secrets here.
PERNOVA_JWT_ISSUER=
PERNOVA_JWT_AUDIENCE=
PERNOVA_JWT_JWKS_URL=
# JSON mapping of approved workload application client IDs to known agent IDs.
PERNOVA_AGENT_CLIENTS_JSON={}

# Optional real model inference through APIM, not direct model-provider access.
# Copy the reviewed gateway's OpenAI v1 base URL (ending in /v1/).
PERNOVA_APIM_RESPONSES_ENDPOINT=
# The gateway API app's api://.../.default scope, not the Foundry downstream scope.
PERNOVA_APIM_SCOPE=
PERNOVA_MODEL_DEPLOYMENT=
# Conservative operator-supplied EUR/token estimate, NOT a billing quotation.
PERNOVA_MODEL_EUR_PER_TOKEN=0
AZURE_CLIENT_ID=

# Optional actual SDK span export to a reviewed collector. No credentials in URL.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Alternative/additional direct Azure Monitor export. Copy resource configuration
# at deployment time, not into source control. Requires AZURE_CLIENT_ID and approved
# ingestion permissions. Configured does not prove that Azure ingested any spans.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional browser Entra sign-in. Vite reads the root .env at build/dev time.
# Register the exact SPA redirect origin and grant the API delegated scope.
# These are public application identifiers, never client secrets or access tokens.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
